generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 BigInt    @id
  title              String
  product_type       String?
  general_category   String?
  category_full_path String?
  description        String
  price_min_usd      Decimal   @db.Decimal(12, 2)
  price_max_usd      Decimal   @db.Decimal(12, 2)
  in_stock_any       Boolean
  featured_image_url String?
  review_count       Int?
  review_rating      Decimal?  @db.Decimal(3, 2)
  created_at         DateTime  @db.Timestamptz(6)
  variants           Variant[]
  images             Image[]

  @@map("products")
}

model Variant {
  product_id    BigInt
  variant_title String
  price_usd     Decimal @db.Decimal(12, 2)
  in_stock      Boolean
  size          String?
  color         String?
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([product_id, variant_title])
  @@map("variants")
}

model Image {
  product_id  BigInt
  image_index Int
  image_url   String  @unique
  alt         String
  product     Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([product_id, image_index])
  @@map("images")
}
